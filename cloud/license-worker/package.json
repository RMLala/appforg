{
  "name": "appforge-license-api",
  "private": true,
  "version": "1.3.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply appforge-licenses --local",
