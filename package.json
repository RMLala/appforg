{
  "name": "appforge-studio",
  "version": "15.8.14",
  "private": true,
  "description": "AppForge Studio Android",
  "scripts": {
    "build": "node scripts/build.cjs",
    "test:cloud": "node --test cloud/license-worker/client/*.test.cjs",
    "sync": "npm run build && cap sync android",
    "open": "cap open android",
    "test:ultimate": "node --test tests/ultimate-business-integration.test.cjs",
    "test:worker": "node --experimental-default-type=module --test cloud/license-worker/src/r2-files.test.mjs cloud/license-worker/tests/cloud-entitlements.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9"
  }
}
